# OAuth login credentials for a test/end-user account.
TEST_USER="user@example.com"
TEST_PASSWORD="replace-me"

# OAuth client credentials from the Eagle Eye/Brivo Video developer portal.
CLIENT_ID="replace-me"
CLIENT_SECRET="replace-me"

# Must exactly match a redirect URI registered for the OAuth client.
REDIRECT_URI="http://127.0.0.1:3333"

# Optional: use a token-exchange proxy instead of CLIENT_SECRET.
# EEN_PROXY_URL="https://your-proxy.example.com"
